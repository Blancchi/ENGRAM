# Copy this file to backend/.env for local overrides. Never commit .env.
#
# ENGRAM_DATABASE_URL: SQLAlchemy database URL.
# When unset, ENGRAM uses SQLite at backend/data/engram.db.
# Prefer an absolute path; relative SQLite paths depend on the working directory.
# ENGRAM_DATABASE_URL=sqlite:///C:/path/to/engram.db
